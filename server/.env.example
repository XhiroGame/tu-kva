# ============================================================
# BEER MUSIC - Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ---------------------------
# Server
# ---------------------------
PORT=3001
NODE_ENV=development

# ---------------------------
# Supabase (Service Role Key - NEVER expose to frontend!)
# ---------------------------
# Get these from: https://supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-secret

# ---------------------------
# CORS
# ---------------------------
# Frontend URL (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# ---------------------------
# Jamendo Music API
# ---------------------------
# 1. Create a free account at https://devportal.jamendo.com
# 2. Register a new app to get your Client ID
# 3. For commercial use in a venue, upgrade to a commercial plan:
#    https://www.jamendo.com/start-licensing
# 4. Set the Client ID below:
JAMENDO_CLIENT_ID=your-jamendo-client-id
JAMENDO_API_URL=https://api.jamendo.com/v3.0

# ---------------------------
# Rate Limiting
# ---------------------------
# Max requests per window per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Queue-specific rate limit (more restrictive)
QUEUE_RATE_LIMIT_WINDOW_MS=60000
QUEUE_RATE_LIMIT_MAX=5

# ---------------------------
# QR Code
# ---------------------------
# Base URL used in QR code generation
# Should be your public frontend URL
QR_BASE_URL=http://localhost:5173
